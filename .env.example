# Scheduled jobs (GitHub Actions secrets). Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web app (Vercel environment variables). The anon key is safe to expose; row level security limits it to reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
